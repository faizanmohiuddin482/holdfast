# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=   # same value as PAYPAL_CLIENT_ID
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Google Gemini (aistudio.google.com > Get API key; the free tier works)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest,gemini-2.5-flash,gemini-flash-lite-latest   # tried in order when one is busy
# GITHUB_TOKEN=                 # optional: raises GitHub API limits when the agent reads repos (60/hour without)

# Optional
# HOLDFAST_FEE_BPS=500           # platform fee, basis points (500 = 5%)
# HOLDFAST_AUTO_RELEASE=true     # let the agent release 100% verdicts with high confidence without waiting for the client
# HOLDFAST_DB=./data/holdfast.db

# Hosted storage (optional): without these, data lives in the local SQLite file above
# FIREBASE_SERVICE_ACCOUNT=      # service-account key JSON on one line (needs the Cloud Datastore User role)
# FIRESTORE_DATABASE_ID=holdfast # named Firestore database; defaults to (default)
# FIRESTORE_COLLECTION_PREFIX=   # e.g. holdfast_ when sharing a database with other data
